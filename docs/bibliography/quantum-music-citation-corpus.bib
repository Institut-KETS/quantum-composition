@article{yamada2021QuantumRandomness,
  author = {Yamada, Reiko and Grandi, Samuele and Muñoz-Gil, Gorka and Barbiero, Luca and Aloy, Albert and Lewenstein, Maciej},
  title = {Applications of Quantum Randomness: From Rabi Oscillations to Fourier Axis Controlling the Musical Timbre},
  journal = {International Journal of Music Science, Technology and Art},
  volume = {3},
  number = {2},
  pages = {17--25},
  year = {2021},
  doi = {10.48293/IJMSTA-77},
  url = {https://doi.org/10.48293/IJMSTA-77},
  eprint = {2109.03511},
  eprinttype = {arXiv},
  abstract = {Randomness has attracted great interest in the field of music composition for quite some time. As early as 1962, Iannis Xenakis started exploring a stochastic approach to randomness by using computer-based interlinking probability functions to determine compositional structure, pitches and their durations. Soon after, composers and music technologists started to explore randomness with various methods of algorithmic compositions, sometimes with the help of artificial intelligence. However, in most cases, the source of randomness they used was in fact deterministic in nature. That is to say, the random numbers that they employed are imperfect in the strict sense. Moreover, the method in which they produced such randomness was extrinsic to the method in which randomness was applied. In this project, we attempt to take a further step by directly producing sound events from the genuine quantum true randomness of quantum physical systems. Through this method, we aim at achieving a new sense of aesthetic effect in music which derives from the true randomness that prevails in the natural quantum world.},
  citesquantummusic = {}
}

@article{zhangLuYin2020GFPRQS,
  author = {Zhang, Rui and Lu, Dayong and Yin, Haiting},
  title = {A Generalized Floating-Point Representation and Manipulation of Quantum Signals Based on {IEEE}-754},
  journal = {International Journal of Theoretical Physics},
  volume = {59},
  number = {3},
  pages = {936--952},
  year = {2020},
  doi = {10.1007/s10773-019-04379-y},
  url = {https://doi.org/10.1007/s10773-019-04379-y},
  abstract = {Quantum information processing has become increasingly attractive in the past few decades due to its extraordinary performance. However, few results of quantum signal and its related manipulations based on quantum computation have emerged in recent years. The paper proposes a generalized floating-point representation of quantum signals (GFPRQS), which is improved by representing an arbitrary quantum signal with p + q qubits. In a floating-point representation, although every number is approximated using three registers, this format allows one to represent a much larger range of values with a given number of qubits than a fixed-point representation. Based on GFPRQS representation, we first present quantum circuits to accomplish basic signal modules, and then design a composite sort module. An example involving mean filtering and its quantum circuit is given to indicate the usability of the model.},
  citesquantummusic = {}
}

@inproceedings{sahin2022QuantumRepresentationsDecimals,
  author = {Şahin, Engin},
  title = {Quantum Representations of Single and Multi-Channel Audio with Decimals},
  booktitle = {Proceedings of the 2nd International Conference on Applied Engineering and Natural Sciences},
  year = {2022},
  address = {Konya, Turkey},
  url = {https://avesis.comu.edu.tr/yayin/13d9effd-2d0f-4a5e-ab2a-7f980bae26b1/quantum-representations-of-single-and-multi-channel-audio-with-decimals},
  abstract = {Quantum computing is being studied widely in many fields, one of which is quantum audio processing. The processes related to quantum audio first prepare classical data as a quantum state in a related quantum-audio representation model and then apply quantum gates and operations to the quantum state. In the QRDA model, amplitude information is expressed only as an unsigned integer, and in the FRQA and QRMA models it is expressed as a signed integer. In the QRDS and GFPRQS models, amplitude information is expressed with floating-point numbers in two different methods. However, these models can express decimal numbers whose integer part is very large and whose decimal precision is low. The amplitude is stored with decimals between -1 and 1 in classical digital audio. This study proposes representations of single- and multi-channel quantum audio with decimals, representing amplitude as a decimal between -1 and 1 rather than as integers or decimals in a very large range in quantum states. The proposed method is compared to existing quantum-audio models in terms of qubit count and decimal precision.},
  citesquantummusic = {wang2016QRDA,yan2018FRQA,li2018QRDS,sahinYilmaz2019QRMA,zhangLuYin2020GFPRQS}
}

@article{yan2022PMQA,
  author = {Yan, Fei and Gao, Song and Iliyasu, Abdullah M. and Chen, Kehan},
  title = {Probability Amplitude-Encoded Multichannel Representation for Quantum Audio Signals},
  journal = {Quantum Information Processing},
  volume = {21},
  number = {3},
  pages = {95},
  year = {2022},
  doi = {10.1007/s11128-022-03435-7},
  url = {https://doi.org/10.1007/s11128-022-03435-7},
  abstract = {A probability amplitude-encoded multichannel representation for quantum audio signals (or simply PMQA) is proposed in this study. As an entangled state, PMQA requires only one qubit to epitomise the bipolar decimal amplitude values of a quantum audio signal, which leads to considerable conservation of qubit resources relative to similar models. Furthermore, the representation provides an embodiment of a signal that can be manipulated via quantum circuits for signal and channel level operations to merge, add, invert, delay, swap, etc. different audio contents. Compared to available quantum audio representations, the proposed PMQA provides lower complexity, and its operations provide essential building blocks for applications in future quantum audio processing.},
  citesquantummusic = {wang2016QRDA,yan2018FRQA,li2018QRDS,sahinYilmaz2019QRMA}
}
