  year = {2015},
  doi = {10.3389/fpsyg.2015.01583},
  url = {https://doi.org/10.3389/fpsyg.2015.01583},
  abstract = {Parallelism represents an essential aspect of human mind/brain activities. One can recognize common features between psychological parallelism and the characteristic parallel structures arising in quantum theory and quantum computation. The article compares classical and quantum Turing machines, discusses quantum computational semantics for cognitive problems, and applies the framework to parallelism in music.},
  citesquantummusic = {}
}

