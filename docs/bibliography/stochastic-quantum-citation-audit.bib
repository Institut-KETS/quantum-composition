  doi = {10.1007/s00220-008-0411-y},
  eprint = {math-ph/0611057},
  archivePrefix = {arXiv},
  url = {https://arxiv.org/abs/math-ph/0611057},
  abstract = {Studies when quantum channels can be decomposed into other channels, including criteria related to continuous quantum dynamical semigroups and Markovian generators. This is an antecedent to quantum-channel indivisibility, which Barandes explicitly distinguishes from indivisibility of ordinary stochastic processes.},
}

@article{Pimenta2025DivisibleIndivisible,
  author = {Pimenta, Leandro Silva},
  title = {Divisible and Indivisible Stochastic-Quantum Dynamics},
  year = {2025},
  journal = {arXiv},
  eprint = {2505.08785},
  archivePrefix = {arXiv},
  primaryClass = {quant-ph},
  url = {https://arxiv.org/abs/2505.08785},
  abstract = {Gives a geometric characterization of divisible and indivisible time evolution for two-configuration systems. It identifies conical regions in stochastic-matrix space, relates divisibility to information decrease, and connects the geometry to the stochastic-quantum correspondence, coarse graining, and dilation.},
}

@article{LeBlond2025DoubleSlitISP,
  author = {LeBlond, David},
  title = {The Electron Double-Slit Experiment from an ISP Perspective},
  year = {2025},
  journal = {arXiv},
  eprint = {2511.02863},
