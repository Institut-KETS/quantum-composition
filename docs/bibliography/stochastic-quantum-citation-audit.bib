% Scope: papers directly about indivisible stochastic processes, the stochastic-quantum
% correspondence, its historical antecedents, or immediate forward applications.
% Abstracts are concise source-grounded summaries; URLs point to open papers or records.

@article{Barandes2023StochasticQuantumTheorem,
  author = {Barandes, Jacob A.},
  title = {The Stochastic-Quantum Theorem},
  year = {2023},
  journal = {arXiv},
  eprint = {2309.03085},
  archivePrefix = {arXiv},
  primaryClass = {quant-ph},
  url = {https://arxiv.org/abs/2309.03085},
  abstract = {Introduces generalized, later called indivisible, stochastic systems and proves a correspondence between them and unitarily evolving quantum systems. The theorem explains the appearance of complex Hilbert spaces, unitary evolution, and the Born rule, and suggests quantum simulation of generalized stochastic processes.},
}

@article{Barandes2025StochasticQuantumCorrespondence,
  author = {Barandes, Jacob A.},
  title = {The Stochastic-Quantum Correspondence},
  year = {2025},
  journal = {Philosophy of Physics},
  volume = {3},
  number = {1},
  pages = {8},
  doi = {10.31389/pop.186},
  eprint = {2302.10778},
  archivePrefix = {arXiv},
  url = {https://philosophyofphysics.lse.ac.uk/articles/10.31389/pop.186},
  abstract = {Argues that every quantum system can be represented as a sufficiently general stochastic process on a configuration space with ordinary probabilities and indivisible dynamics. The correspondence provides a reconstruction of quantum theory and a realist treatment of interference, decoherence, entanglement, noncommutative observables, and measurement.},
}

@article{Barandes2025IndivisibleProcesses,
  author = {Barandes, Jacob A.},
  title = {Quantum Systems as Indivisible Stochastic Processes},
  year = {2025},
  journal = {arXiv},
  eprint = {2507.21192},
  archivePrefix = {arXiv},
  primaryClass = {quant-ph},
  url = {https://arxiv.org/abs/2507.21192},
  abstract = {Reviews indivisible stochastic processes and the stochastic-quantum correspondence, treating quantum systems as ordinary-probability processes whose transition laws need not compose over intermediate times. Develops consequences for gauge invariance, dynamical symmetries, Hilbert-space dilations, and the indivisible interpretation of quantum theory.},
}

@article{MilzModi2021QuantumStochasticProcesses,
  author = {Milz, Simon and Modi, Kavan},
  title = {Quantum Stochastic Processes and Quantum Non-Markovian Phenomena},
  year = {2021},
  journal = {PRX Quantum},
  volume = {2},
  pages = {030201},
  doi = {10.1103/PRXQuantum.2.030201},
  eprint = {2012.01894},
  archivePrefix = {arXiv},
  url = {https://arxiv.org/abs/2012.01894},
  abstract = {Reviews quantum stochastic processes and operational notions of quantum non-Markovianity, emphasizing process-tensor methods and the distinction between memory, divisibility, and multi-time correlations. Barandes identifies this review as the first research-literature appearance of the term indivisible stochastic process.},
}

@article{WolfCirac2008DividingQuantumChannels,
  author = {Wolf, Michael M. and Cirac, J. Ignacio},
  title = {Dividing Quantum Channels},
  year = {2008},
  journal = {Communications in Mathematical Physics},
  volume = {279},
