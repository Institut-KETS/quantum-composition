}

@article{Calvo2026OnSQC,
  author = {Calvo, Sami},
  title = {On the Stochastic-Quantum Correspondence},
  year = {2026},
  journal = {arXiv},
  eprint = {2601.18720},
  archivePrefix = {arXiv},
  primaryClass = {quant-ph},
  url = {https://arxiv.org/abs/2601.18720},
  abstract = {Recasts Barandes's stochastic-quantum correspondence in bra-ket notation and claims derivations of the six textbook quantum axioms from a single axiom of generally indivisible stochastic evolution. It discusses continuous bases, fields, the classical limit, and measurement.},
}

